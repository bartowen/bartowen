# Supabase — copia este archivo a .env.local y completa los valores.
# Los encuentras en: Supabase Dashboard > Project Settings > API

# URL del proyecto (segura para el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Service role key — SOLO en el servidor. NUNCA la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
